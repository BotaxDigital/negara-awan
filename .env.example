# NEGARA DIATAS AWAN — Environment Variables
# Copy ini ke .env dan isi nilai yang dikosongkan

# ============================================
# GOOGLE SHEETS (Service Account)
# ============================================
# 1. Buat project di Google Cloud Console
# 2. Enable Google Sheets API
# 3. Buat Service Account → download JSON key
# 4. Share spreadsheet ke email service account (editor)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json

# ============================================
# LLM SCORING (OpenRouter - recommended)
# ============================================
# Daftar di openrouter.ai → buat API key
# Model murah & cepat: openai/gpt-4o-mini, google/gemini-flash-1.5
OPENAI_API_KEY=sk-or-xxxxxxxxxxxx
OPENAI_BASE_URL=https://openrouter.ai/api/v1
SCORING_MODEL=openai/gpt-4o-mini

# ============================================
# YOUTUBE UPLOAD (OAuth 2.0)
# ============================================
# 1. Google Cloud Console → OAuth 2.0 Client ID (Desktop app)
# 2. Jalankan: node packages/render-pipeline/get-youtube-token.js (akan dibuat)
# 3. Copy refresh_token ke sini
YOUTUBE_CLIENT_ID=xxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxx
YOUTUBE_REFRESH_TOKEN=xxx

# ============================================
# INSTAGRAM / FACEBOOK (Graph API)
# ============================================
# 1. Meta Developer → App → Instagram Basic Display + Pages
# 2. Generate long-lived access token (60 hari)
# 3. Instagram Business/Creator account linked to FB Page
INSTAGRAM_ACCESS_TOKEN=xxx
INSTAGRAM_USER_ID=xxx
FACEBOOK_ACCESS_TOKEN=xxx
FACEBOOK_PAGE_ID=xxx

# ============================================
# ELEVENLABS VOICEOVER
# ============================================
# 1. Daftar di elevenlabs.io → dapatkan API key
# 2. Pilih voice ID dari Voice Library
ELEVENLABS_API_KEY=sk_a6393f29cae163557d2cf205fb2bd39fda255747d635b468
ELEVENLABS_VOICE_ID=zmqLb9Ysr8fUvDD7hXK8
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# ============================================
# TELEGRAM BOT
# ============================================
# 1. Chat @BotFather → /newbot → dapatkan token
# 2. Tambahkan bot ke channel/group target
# 3. Dapatkan chat_id: @userinfobot atau di webhook
TELEGRAM_BOT_TOKEN=xxx:xxx
TELEGRAM_CHAT_ID=@botax_claude_bot

# ============================================
# OPTIONAL: ANALYTICS / MONITORING
# ============================================
# SENTRY_DSN=xxx
# LOG_LEVEL=info